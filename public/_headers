# _headers: how long browsers and Cloudflare keep the shop's files (Cloudflare Pages, this file at the root of public/,
# which serves /squelette/, /scene/ and /insectes/ as outils/servir.py does locally).
# - pages, modules and styles: always checked again (a 304 most of the time), so a page never runs with the modules of
#   another publication (an old noyau.mjs under a new page leaves it empty);
# - data (boutique.json, sens.json...): five minutes, then checked again in the background for a day;
# - bouquets: a month, a collection's life; they are fixed once published (a redrawn bouquet needs a new sw.js VERSION
#   and waits for this month at worst in the browser's own cache: purge Cloudflare's cache when one is redrawn);
# - fonts and versioned libraries: a year, immutable (a new font or library gets a new name);
# - the service worker itself: always checked again (the browser looks for a new one at every visit anyway).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), payment=(), usb=(), microphone=(self), display-capture=(self)
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-qRKUe8SUFdIif91IhfJf+EZ9NOcG1RB67saB5idIToc=' 'sha256-zfCflHQZNcUcj8kXBVkID2K2csbcl7iGITeeQ7n86vg=' 'sha256-f3our/mA2kfpQPMnEdOHVLLXKa1oyJ6D3UdDXnkia5o=' 'sha256-qh7eNlC/NaxtvrB3yyWBHFSUZNNytVKxVdrhzC3reRk=' 'sha256-p3WCSgxuzaBIJnAFQjbuPOo8QqhcvJnDDzi0OGpfr4Y=' 'sha256-FLOO+/vtQJQmGh8kwTcdXxKB+Y34mtaTeizjwBuRe/A=' 'sha256-a6viyP9AWmSdBca5JVu448fKbVnsBBciDEQXAKoqen8=' 'sha256-3td5CGr8gbxmT3xqYFLUcPRKM5NyoImSi8aXo4/fsNM=' 'sha256-1p6J9vRGbLFab8Kxkpk4iaWuXSrQIZp4mPzkFOEsHG8=' 'sha256-ozNg2Reg6tTcPA3XgmoMwjligBYQmt4GftqkpVRbVqk=' 'sha256-OBe09EE9viTRnP60saBElWJjWJ/7Moh3YjEXPr0qiHM=' 'sha256-mLlJoB/YKyV146RsfJicKMNeCDpqrSSuusCjs3ZQ6ok=' 'unsafe-eval' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; font-src 'self'; connect-src 'self' blob: data:; worker-src 'self' blob:; frame-src 'self' https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

/squelette/*.html
  Cache-Control: public, max-age=0, must-revalidate

/squelette/
  Cache-Control: public, max-age=0, must-revalidate

/squelette/*.mjs
  Cache-Control: public, max-age=0, must-revalidate

/squelette/*.js
  Cache-Control: public, max-age=0, must-revalidate

/squelette/*.css
  Cache-Control: public, max-age=0, must-revalidate

/squelette/*.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/scene/*.mjs
  Cache-Control: public, max-age=0, must-revalidate

/scene/*.js
  Cache-Control: public, max-age=0, must-revalidate

/scene/*.css
  Cache-Control: public, max-age=0, must-revalidate

/scene/boutique.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/scene/bouquets/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/scene/polices/*
  Cache-Control: public, max-age=31536000, immutable

/insectes/runtime/*.mjs
  Cache-Control: public, max-age=0, must-revalidate

/insectes/runtime/vendor/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/insectes/*/atlas/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# last, so they win over the rules above that match them too (rules add up; "!" takes off what an earlier one set)
/squelette/sw.js
  ! Cache-Control
  Cache-Control: no-cache
